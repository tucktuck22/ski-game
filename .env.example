# Both values are public by design: there are no accounts, and Row Level Security
# is what enforces the rules (see contracts/storage-api.md). The anon key being
# in the client bundle is expected, not a leak.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Both values must ALSO be set as GitHub repository secrets, under the same
# names. The deploy workflow builds with them, and the keep-alive workflow
# (.github/workflows/keepalive.yml) uses them to stop the free Supabase project
# pausing after 7 days of inactivity - see docs/adr/0007.

# Organizer URL secret. Kept out of the player bundle; see FR-006.
# This is secrecy, not authentication - anyone holding it has organizer powers.
SUPABASE_SERVICE_ROLE_KEY=only-for-local-migrations
