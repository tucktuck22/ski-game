# Normalize text files in the repository to LF.
* text=auto

# Shell scripts MUST check out with LF, even on Windows. core.autocrlf=true is
# set globally on this machine, and CRLF endings make bash fail with
# "$'\r': command not found". Spec Kit's workflow scripts live in
# .specify/scripts/bash/, so this rule is load-bearing, not cosmetic.
*.sh text eol=lf

# Windows-native scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Explicit text formats.
*.md   text
*.json text
*.yml  text
*.yaml text

# Binary assets: never apply line-ending or whitespace conversion.
# The constitution requires large-file handling for binary assets; when Git LFS
# is enabled, these patterns are the ones to migrate.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.psd  binary
*.aseprite binary
*.ase  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.flac binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.fbx  binary
*.blend binary
*.glb  binary
*.gltf binary

# Binary sprite atlases are version-controlled via LFS (constitution: Asset management).
#
# Audio was synthesised at runtime and there were no audio binaries to track,
# until feature 003 introduced recorded music. The two masters under
# assets/audio/masters/ are committed as ordinary Git objects, NOT via LFS: the
# environment they were added from denies lfs.github.com at the network gateway,
# so an LFS pointer could be committed but never pushed. They stay marked binary
# above. Migrating them - `git lfs migrate import --include='*.mp3'` - is the
# outstanding half of the constitution's asset-management rule, and rewrites
# history, so it wants doing before the repository gains more contributors.
# See assets/audio/README.md.
*.png filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text
