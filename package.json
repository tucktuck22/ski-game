{
  "name": "shredpocalypse-86",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:sim": "vitest run tests/sim",
    "test:course": "vitest run tests/course",
    "test:monkey": "vitest run tests/sim/monkey.test.ts",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "playwright test",
    "test:build": "playwright test --config playwright.build.config.ts",
    "test:determinism": "playwright test tests/e2e/determinism.spec.ts",
    "test:perf": "playwright test tests/e2e/performance.spec.ts",
    "db:migrate": "node tools/migrate.mjs",
    "gen:trig": "node --experimental-strip-types tools/gen-trig.ts",
    "gen:courses": "node --experimental-strip-types tools/gen-courses.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "pixi.js": "^8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.5.0",
    "eslint": "^9.10.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
